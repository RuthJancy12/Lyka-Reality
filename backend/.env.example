# ==============================================================================
# LYKA REALTY — Backend Environment Variables Template
# ==============================================================================
# Copy this file to `.env` in the `backend/` directory.
# In production (e.g., Render), configure these in your Service Environment settings.
# NEVER commit the actual `.env` file containing production credentials.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Connection (Supabase PostgreSQL or local SQLite fallback)
# Production Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Local Development: sqlite:///./lyka_realty.db
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# CORS Allowed Origins (Comma-separated list of permitted frontend origins)
# Example: http://localhost:5173,https://lyka-realty.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=real-estimate-6b291
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
# Optional inline JSON credentials for container/cloud deployment:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI Realtime & Fallback Concierge AI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

