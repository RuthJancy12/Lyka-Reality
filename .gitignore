# ==============================================================================
# LYKA REALTY — Git Ignore Rules
# ==============================================================================

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
firebase-service-account*.json
**/firebase-service-account*.json

# Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
**/dist/
build/
**/build/
dist-ssr/
*.local

# Python Virtual Environments & Bytecode
.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# Test & Coverage Outputs
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.oxlintrc.json

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
brain_prompt.txt
lyka-verification-*.txt
*.backup-*
