# ==============================================================================
# LYKA REALTY — Frontend Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In production (e.g., Vercel), set these in Project Settings -> Environment Variables.
#
# NOTE: All VITE_* variables are embedded into the client-side bundle and are
# publicly visible in the browser. NEVER put secrets or private keys here.
# ==============================================================================

# Firebase Web App Configuration (Public Client Identifiers)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Firebase Authentication Persistence
# false (default): Uses browserLocalPersistence (IndexedDB) so users stay logged in across refresh
# true: Uses inMemoryPersistence for strict zero-browser-persistence (users must log in after every refresh)
VITE_FIREBASE_IN_MEMORY_AUTH=false

# Backend API Base URL (no trailing slash)
# Local: http://localhost:8000 or http://127.0.0.1:8000
# Production: https://lyka-realty-backend.onrender.com
VITE_API_URL=http://localhost:8000
